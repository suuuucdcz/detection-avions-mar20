# Environnement Python (recréé par `uv sync`)
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# Données : trop lourdes pour Git (425 Mo). On ne versionne que les fichiers de split.
data/*
!data/splits/

# Poids des modèles : seuls les 2 modèles finaux (50 Mo) sont dans Git, pour que la démo se lance
# après un simple clone. Les témoins et les modèles de comparaison (90 Mo) restent sur le Drive.
models/*
*.pt
*.joblib
*.onnx
!models/detecteur_1classe.pt
!models/classifieur_resnet18.pt
# Résultats des entraînements (runs/) : versionnés comme preuve des scores (courbes,
# métriques, matrices de confusion), sauf les points de sauvegarde intermédiaires
runs/**/weights/

# Sujet du prof : document de cours, pas à publier dans un dépôt public
docs/main.pdf

# Fichiers système
.DS_Store
Thumbs.db
.vscode/
.idea/

# Poids téléchargés par Ultralytics (modèles pré-entraînés, vérification AMP)
/weights/

# Corpus de test annoté : les XML, les aperçus (boîtes dessinées), le tableau et le LISEZMOI sont
# dans Git ; les images d'origine (44 Mo), qui viennent du dataset du prof, restent dans data/raw/
reports/corpus_test_annote/images/
